{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "share-your-dance",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "Open Dance Studio",
        "description": "Create a daily dance playground",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/create-post"
      }
    ]
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "dev": "vite build --config vite.config.ts --watch"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "7 0 * * *"
      }
    }
  }
}
