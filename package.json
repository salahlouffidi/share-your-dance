{
  "name": "reddit-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.local.config.ts --host 127.0.0.1",
    "build": "npm run check && vite build --config vite.local.config.ts",
    "preview": "vite preview --config vite.local.config.ts --host 127.0.0.1",
    "check": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "build:reddit": "npm run check && vite build --config vite.config.ts",
    "login:reddit": "devvit login",
    "dev:reddit": "devvit playtest",
    "upload:reddit": "npm run check && devvit upload",
    "test:ui": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@devvit/start": "0.15.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.3",
    "devvit": "0.15.3",
    "eslint": "10.0.1",
    "globals": "17.4.0",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
